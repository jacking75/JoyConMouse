<Window x:Class="JoyConMouse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JoyConMouse.App.Views"
        Title="JoyConMouse" Width="880" Height="600" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontSize="13"
        Background="#FFF9FAFB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 상태 표시줄 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                            IsEnabled="{Binding CanTogglePause}" Margin="0,0,8,0" MinWidth="80" />
                    <Button Content="{StaticResource Button.Diagnostics}" Command="{Binding OpenDiagnosticsCommand}" />
                </StackPanel>
                <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0"
                            Visibility="{Binding HasActiveBattery, Converter={StaticResource BoolToVis}}"
                            ToolTip="{StaticResource Battery.Hint}">
                    <views:BatteryIndicator Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding BatteryText}" VerticalAlignment="Center" Foreground="#FF374151" />
                </StackPanel>
                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StateText}" />
            </DockPanel>
        </Border>

        <!-- 알림(설정 파일 손상 등) -->
        <Border DockPanel.Dock="Top" Background="#FFFEF3C7" Padding="16,6"
                Visibility="{Binding Notice, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 장치 목록·그림 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{StaticResource Title.Devices}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                         MinHeight="64" MaxHeight="150" BorderBrush="#FFE5E7EB">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SideName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ShortId}" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EmphasizeId}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFB45309" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{StaticResource Device.Active}" Margin="8,0,0,0" Foreground="#FF2EA043"
                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <views:BatteryIndicator Percent="{Binding BatteryPercent}" Charging="{Binding Charging}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Battery}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Top" Text="{StaticResource Title.NoDevices}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Top" Content="{StaticResource Button.Bluetooth}" Command="{Binding OpenBluetoothCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,6" />
                <CheckBox DockPanel.Dock="Top" Content="{StaticResource Option.KeepConnected}" IsChecked="{Binding KeepConnected}"
                          ToolTip="{StaticResource Option.KeepConnectedHint}" Margin="0,0,0,8" />
                <views:JoyConDiagram Side="{Binding DiagramSide}" Pressed="{Binding DiagramPressed}" Margin="8" MaxHeight="320" />
            </DockPanel>

            <!-- 오른쪽: 편집 -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsEditTab, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{StaticResource Title.EditSide}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="{StaticResource Side.Left}" IsChecked="{Binding IsEditingLeft}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <RadioButton Content="{StaticResource Side.Right}" IsChecked="{Binding IsEditingRight}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                            Visibility="{Binding IsEditTab, Converter={StaticResource BoolToVis}}">
                    <Button Content="{StaticResource Button.Mirror}" Command="{Binding MirrorCommand}" Margin="0,0,8,0" />
                    <Button Content="{StaticResource Button.RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" />
                </StackPanel>

                <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="12">
                    <TabItem Header="{StaticResource Tab.Stick}" DataContext="{Binding Profile}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{StaticResource Stick.MaxSpeed}" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding MaxSpeedMin}" Maximum="{Binding MaxSpeedMax}"
                                        Value="{Binding MaxSpeed}" SmallChange="50" LargeChange="200" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MaxSpeed, StringFormat={}{0:0}}" Style="{StaticResource RowValue}" />

                                <TextBlock Grid.Row="1" Text="{StaticResource Stick.Curve}" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding CurveMin}" Maximum="{Binding CurveMax}"
                                        Value="{Binding CurveExponent}" SmallChange="0.1" LargeChange="0.5" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CurveExponent, StringFormat={}{0:0.0}}" Style="{StaticResource RowValue}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{StaticResource Stick.CurveHint}"
                                           Style="{StaticResource Caption}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Text="{StaticResource Stick.Deadzone}" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="{Binding DeadzoneMinPercent}" Maximum="{Binding DeadzoneMaxPercent}"
                                        Value="{Binding DeadzonePercent}" SmallChange="1" LargeChange="5" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DeadzonePercent, StringFormat={}{0:0}%}" Style="{StaticResource RowValue}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{StaticResource Stick.DeadzoneHint}"
                                           Style="{StaticResource Caption}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{StaticResource Tab.Scroll}" DataContext="{Binding Profile}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{StaticResource Scroll.Step}" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding StepDeltaMin}" Maximum="{Binding StepDeltaMax}"
                                        Value="{Binding StepDelta}" SmallChange="10" LargeChange="60" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StepDelta, StringFormat={}{0:0}}" Style="{StaticResource RowValue}" />

                                <TextBlock Grid.Row="1" Text="{StaticResource Scroll.InitialDelay}" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding InitialDelayMin}" Maximum="{Binding InitialDelayMax}"
                                        Value="{Binding InitialDelayMs}" SmallChange="10" LargeChange="50" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding InitialDelayMs, StringFormat={}{0:0} ms}" Style="{StaticResource RowValue}" />

                                <TextBlock Grid.Row="2" Text="{StaticResource Scroll.Interval}" Style="{StaticResource RowLabel}" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding IntervalMin}" Maximum="{Binding IntervalMax}"
                                        Value="{Binding RepeatIntervalMs}" SmallChange="5" LargeChange="20" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RepeatIntervalMs, StringFormat={}{0:0} ms}" Style="{StaticResource RowValue}" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{StaticResource Tab.Buttons}" DataContext="{Binding Profile}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{StaticResource Buttons.NoPauseWarning}" Foreground="#FFB45309"
                                       TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTogglePause}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Bottom" Text="{StaticResource Buttons.PressHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource Buttons.Header.Physical}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="{StaticResource Buttons.Header.Action}" Style="{StaticResource Caption}" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Buttons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,3" Margin="0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                <Setter Property="Background" Value="#FFFFEDD5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" MaxWidth="260" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                              DisplayMemberPath="Name" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="{StaticResource Tab.Test}" DataContext="{Binding InputTest}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{StaticResource Test.Intro}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding DeviceText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ProgressText}" Foreground="#FF2563EB" FontWeight="SemiBold" Margin="0,0,0,10"
                                           Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}" />

                                <Grid Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 버튼 체크리스트 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{StaticResource Test.Buttons}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Buttons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" MinWidth="96"
                                                            ToolTip="{Binding Raw}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#FFD1D5DB" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detected}" Value="True">
                                                                        <Setter Property="Background" Value="#FFDCFCE7" />
                                                                        <Setter Property="BorderBrush" Value="#FF2EA043" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                        <Setter Property="Background" Value="#FFFFEDD5" />
                                                                        <Setter Property="BorderBrush" Value="#FFF97316" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✓" Foreground="#FF2EA043" FontWeight="Bold" Margin="0,0,6,0"
                                                                       Visibility="{Binding Detected, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 스틱 -->
                                    <StackPanel Grid.Column="2" Width="200">
                                        <TextBlock Text="{StaticResource Test.Stick}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                        <Canvas Width="140" Height="140" HorizontalAlignment="Left">
                                            <Ellipse Width="140" Height="140" Fill="White" Stroke="#FFD1D5DB" StrokeThickness="1" />
                                            <Ellipse Width="{Binding DeadzoneDiameter}" Height="{Binding DeadzoneDiameter}"
                                                     Canvas.Left="{Binding DeadzoneOffset}" Canvas.Top="{Binding DeadzoneOffset}"
                                                     Fill="#FFF3F4F6" Stroke="#FF9CA3AF" StrokeDashArray="2 2" />
                                            <Line X1="70" Y1="4" X2="70" Y2="136" Stroke="#FFE5E7EB" />
                                            <Line X1="4" Y1="70" X2="136" Y2="70" Stroke="#FFE5E7EB" />
                                            <Ellipse Width="14" Height="14" Fill="#FFF97316" Canvas.Left="{Binding DotLeft}" Canvas.Top="{Binding DotTop}" />
                                        </Canvas>
                                        <TextBlock Text="{Binding StickText}" FontFamily="Consolas" Margin="0,4,0,4" />
                                        <ItemsControl ItemsSource="{Binding Directions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" BorderThickness="1" Padding="6,2" Margin="0,0,4,4" ToolTip="{Binding Raw}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="BorderBrush" Value="#FFD1D5DB" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Detected}" Value="True">
                                                                        <Setter Property="Background" Value="#FFDCFCE7" />
                                                                        <Setter Property="BorderBrush" Value="#FF2EA043" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✓" Foreground="#FF2EA043" FontWeight="Bold" Margin="0,0,4,0"
                                                                       Visibility="{Binding Detected, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding JitterText}" Style="{StaticResource Caption}" Margin="0,4,0,4" />
                                        <Button Content="{Binding RestButtonText}" Command="{Binding MeasureRestCommand}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4" />
                                        <TextBlock Text="{StaticResource Test.JitterWarning}" Foreground="#FFB45309" TextWrapping="Wrap" FontSize="12"
                                                   Visibility="{Binding JitterWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding UnknownText}" Foreground="#FFDC2626" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding UnknownText, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding RawText}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="{StaticResource Test.Reset}" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
                                    <Button Content="{StaticResource Test.Copy}" Command="{Binding CopyCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
