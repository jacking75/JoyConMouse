<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 일반 빌드 출력은 저장소 루트 bins\ 에 모으고 .NET 버전 하위 폴더는 만들지 않는다.
         게시 스크립트(-p:PackagingBuild=true)는 .NET 기본 폴더를 써서 일반 빌드·RID 빌드와 섞이지 않게 한다. -->
    <OutputPath Condition="'$(PackagingBuild)' != 'true'">$(MSBuildThisFileDirectory)..\..\bins\</OutputPath>
    <AppendTargetFrameworkToOutputPath Condition="'$(PackagingBuild)' != 'true'">false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoyConMouseCoreTests" />
  </ItemGroup>

</Project>
