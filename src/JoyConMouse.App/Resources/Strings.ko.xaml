<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 화면에 보이는 문자열을 한곳에 모은다. 코드에서는 Strings.Get("키") 로 읽는다. -->

    <!-- 상태 -->
    <sys:String x:Key="State.NoDevice">조이콘을 연결해 주세요</sys:String>
    <sys:String x:Key="State.NeedsChoice">사용할 조이콘을 선택해 주세요</sys:String>
    <sys:String x:Key="State.Disconnected">{0} 연결 끊김 — 조이콘의 아무 버튼이나 누르면 다시 연결됩니다</sys:String>
    <sys:String x:Key="State.WaitingNeutral">{0} 중립 대기 중 — 스틱과 버튼을 놓아 주세요</sys:String>
    <sys:String x:Key="State.Active">{0} 사용 중</sys:String>
    <sys:String x:Key="State.Paused">{0} 일시정지</sys:String>
    <sys:String x:Key="State.PausedSystem">{0} 일시정지(절전·잠금)</sys:String>
    <sys:String x:Key="State.Testing">{0} 연결 확인 중 — 마우스 조작이 멈춰 있습니다</sys:String>

    <!-- 배터리 -->
    <sys:String x:Key="Battery.Label">배터리: {0}</sys:String>
    <sys:String x:Key="Battery.Unknown">알 수 없음</sys:String>
    <sys:String x:Key="Battery.Critical">매우 낮음</sys:String>
    <sys:String x:Key="Battery.Low">낮음</sys:String>
    <sys:String x:Key="Battery.Medium">보통</sys:String>
    <sys:String x:Key="Battery.High">높음</sys:String>
    <sys:String x:Key="Battery.Charging">{0} (충전 중)</sys:String>

    <!-- 버튼·제목 -->
    <sys:String x:Key="Button.Pause">일시정지</sys:String>
    <sys:String x:Key="Button.Resume">재개</sys:String>
    <sys:String x:Key="Button.Diagnostics">진단</sys:String>
    <sys:String x:Key="Button.Bluetooth">Bluetooth 설정</sys:String>
    <sys:String x:Key="Button.RestoreDefaults">기본값 복원</sys:String>
    <sys:String x:Key="Button.Mirror">반대쪽 배치 미러로 가져오기</sys:String>
    <sys:String x:Key="Title.Devices">연결된 조이콘</sys:String>
    <sys:String x:Key="Title.NoDevices">연결된 조이콘이 없습니다. Bluetooth 설정에서 Joy-Con을 페어링하세요.</sys:String>
    <sys:String x:Key="Title.EditSide">편집할 쪽:</sys:String>
    <sys:String x:Key="Side.Left">왼쪽</sys:String>
    <sys:String x:Key="Side.Right">오른쪽</sys:String>
    <sys:String x:Key="Side.LeftDevice">조이콘(L)</sys:String>
    <sys:String x:Key="Side.RightDevice">조이콘(R)</sys:String>
    <sys:String x:Key="Device.Active">사용 중</sys:String>
    <sys:String x:Key="Option.KeepConnected">쓰지 않을 때도 연결 유지</sys:String>
    <sys:String x:Key="Option.KeepConnectedHint">조이콘을 30초 이상 쓰지 않으면 20초마다 신호를 보내 연결이 끊기지 않게 합니다. 조이콘 배터리 사용이 조금 늘어납니다.</sys:String>

    <!-- 탭 -->
    <sys:String x:Key="Tab.Stick">감도</sys:String>
    <sys:String x:Key="Tab.Scroll">스크롤</sys:String>
    <sys:String x:Key="Tab.Buttons">버튼 배치</sys:String>
    <sys:String x:Key="Tab.Test">연결 확인</sys:String>

    <!-- 연결 확인 탭 -->
    <sys:String x:Key="Test.Intro">조이콘을 세로로 쥐고 아래 버튼을 하나씩 눌러 보세요. 인식되면 ✓ 표시가 붙고 왼쪽 그림에서도 같은 버튼이 켜집니다. 이 탭을 보는 동안에는 마우스 조작이 멈춥니다.</sys:String>
    <sys:String x:Key="Test.NoDevice">사용할 조이콘을 연결하고 왼쪽 목록에서 선택해 주세요.</sys:String>
    <sys:String x:Key="Test.Device">{0} …{1} · {2} · 시리얼 {3} · 연결 {4} · 배터리 {5}</sys:String>
    <sys:String x:Key="Test.Yes">있음</sys:String>
    <sys:String x:Key="Test.No">없음</sys:String>
    <sys:String x:Key="Test.Buttons">버튼</sys:String>
    <sys:String x:Key="Test.Stick">스틱 — 네 방향으로 끝까지 밀었다가 놓아 보세요</sys:String>
    <sys:String x:Key="Test.Dir.Up">위</sys:String>
    <sys:String x:Key="Test.Dir.Down">아래</sys:String>
    <sys:String x:Key="Test.Dir.Left">왼쪽</sys:String>
    <sys:String x:Key="Test.Dir.Right">오른쪽</sys:String>
    <sys:String x:Key="Test.Jitter">손을 뗐을 때 중앙 흔들림 최대: {0} (데드존 {1})</sys:String>
    <sys:String x:Key="Test.JitterNone">중앙 흔들림: 스틱에서 손을 떼고 아래 버튼을 누르세요.</sys:String>
    <sys:String x:Key="Test.RestMeasure">손 떼고 3초 측정</sys:String>
    <sys:String x:Key="Test.RestMeasuring">측정 중… {0}초 (스틱을 건드리지 마세요)</sys:String>
    <sys:String x:Key="Test.JitterWarning">흔들림이 데드존보다 커서 손을 떼도 커서가 움직일 수 있습니다. 감도 탭에서 데드존을 높이세요.</sys:String>
    <sys:String x:Key="Test.Progress">버튼 {0}/{1} · 스틱 방향 {2}/{3}</sys:String>
    <sys:String x:Key="Test.Raw">SDL 입력: {0} · {1}</sys:String>
    <sys:String x:Key="Test.Unknown">인식되지 않은 입력: {0} — 결과를 복사해 개발자에게 알려 주세요.</sys:String>
    <sys:String x:Key="Test.Reset">다시 확인</sys:String>
    <sys:String x:Key="Test.Copy">결과 복사</sys:String>
    <sys:String x:Key="Stick.MaxSpeed">스틱 감도</sys:String>
    <sys:String x:Key="Stick.Curve">미세 이동 정도</sys:String>
    <sys:String x:Key="Stick.CurveHint">클수록 스틱을 조금 기울였을 때 더 느리게 움직입니다.</sys:String>
    <sys:String x:Key="Stick.Deadzone">데드존</sys:String>
    <sys:String x:Key="Stick.DeadzoneHint">손을 뗐는데 커서가 혼자 움직이면 데드존을 높이세요.</sys:String>
    <sys:String x:Key="Scroll.Step">스크롤 양</sys:String>
    <sys:String x:Key="Scroll.InitialDelay">반복 시작 지연</sys:String>
    <sys:String x:Key="Scroll.Interval">반복 간격(작을수록 빠름)</sys:String>
    <sys:String x:Key="Buttons.Header.Physical">물리 버튼</sys:String>
    <sys:String x:Key="Buttons.Header.Action">기능</sys:String>
    <sys:String x:Key="Buttons.NoPauseWarning">일시정지 토글이 지정된 버튼이 없습니다. 일시정지하면 트레이 메뉴나 이 창에서만 재개할 수 있습니다.</sys:String>
    <sys:String x:Key="Buttons.PressHint">조이콘 버튼을 누르면 왼쪽 그림과 이 목록에서 강조됩니다.</sys:String>

    <!-- 동작 이름 -->
    <sys:String x:Key="Action.None">없음</sys:String>
    <sys:String x:Key="Action.LeftClick">왼쪽 클릭</sys:String>
    <sys:String x:Key="Action.RightClick">오른쪽 클릭</sys:String>
    <sys:String x:Key="Action.MiddleClick">가운데 클릭</sys:String>
    <sys:String x:Key="Action.ScrollUp">위로 스크롤</sys:String>
    <sys:String x:Key="Action.ScrollDown">아래로 스크롤</sys:String>
    <sys:String x:Key="Action.ScrollLeft">왼쪽으로 스크롤</sys:String>
    <sys:String x:Key="Action.ScrollRight">오른쪽으로 스크롤</sys:String>
    <sys:String x:Key="Action.TogglePause">일시정지 토글</sys:String>

    <!-- 알림 -->
    <sys:String x:Key="Notice.SettingsBroken">설정 파일이 손상되어 기본값으로 시작했습니다. 원본은 {0} 에 보관했습니다.</sys:String>
    <sys:String x:Key="Notice.SettingsNewer">새 버전의 JoyConMouse가 만든 설정 파일입니다. 이 버전에서는 설정을 저장하지 않습니다.</sys:String>
    <sys:String x:Key="Notice.SdlError">조이콘 입력을 초기화하지 못했습니다: {0}</sys:String>
    <sys:String x:Key="Tray.Title">JoyConMouse</sys:String>
    <sys:String x:Key="Tray.StillRunning">JoyConMouse는 트레이에서 계속 실행됩니다.</sys:String>
    <sys:String x:Key="Tray.Disconnected">{0} 연결이 끊어졌습니다. 조이콘의 아무 버튼이나 누르면 다시 연결됩니다. 연결되지 않으면 Bluetooth 설정을 확인하세요.</sys:String>
    <sys:String x:Key="Tray.Reconnected">{0} 다시 연결됨 — 스틱과 버튼을 놓으면 사용을 시작합니다.</sys:String>
    <sys:String x:Key="Tray.NeedsChoice">사용할 조이콘을 선택해 주세요. 트레이 아이콘을 더블클릭하면 설정 창이 열립니다.</sys:String>
    <sys:String x:Key="Tray.Menu.Pause">일시정지</sys:String>
    <sys:String x:Key="Tray.Menu.Resume">재개</sys:String>
    <sys:String x:Key="Tray.Menu.ActiveDevice">활성 조이콘</sys:String>
    <sys:String x:Key="Tray.Menu.NoDevice">(연결된 조이콘 없음)</sys:String>
    <sys:String x:Key="Tray.Menu.Open">설정 열기</sys:String>
    <sys:String x:Key="Tray.Menu.Startup">시작 프로그램에 등록</sys:String>
    <sys:String x:Key="Tray.Menu.Diagnostics">진단 정보 내보내기</sys:String>
    <sys:String x:Key="Tray.Menu.Exit">종료</sys:String>
    <sys:String x:Key="Startup.Unavailable">시작 프로그램 설정을 바꾸지 못했습니다.</sys:String>
    <sys:String x:Key="Startup.DisabledByUser">시작 프로그램이 Windows에서 꺼져 있습니다. 작업 관리자의 [시작 앱]에서 JoyConMouse를 켜 주세요.</sys:String>
    <sys:String x:Key="Startup.DisabledByPolicy">이 PC의 정책으로 시작 프로그램을 켤 수 없습니다.</sys:String>
    <sys:String x:Key="Tray.DiagnosticsSaved">진단 정보를 바탕화면에 저장했습니다: {0}</sys:String>
    <sys:String x:Key="Tray.DiagnosticsFailed">진단 정보를 저장하지 못했습니다: {0}</sys:String>

    <!-- 진단 창 -->
    <sys:String x:Key="Diag.Title">JoyConMouse 진단</sys:String>
    <sys:String x:Key="Diag.Latency">내부 지연(스냅샷 → SendInput 반환)</sys:String>
    <sys:String x:Key="Diag.Tick">입력 스레드 틱 간격</sys:String>
    <sys:String x:Key="Diag.Failures">SendInput 실패 횟수</sys:String>
    <sys:String x:Key="Diag.Timer">고해상도 타이머</sys:String>
    <sys:String x:Key="Diag.Note">지연은 앱 내부 처리 시간만 뜻합니다. Bluetooth 전송과 화면 표시 시간은 포함하지 않습니다.</sys:String>
    <sys:String x:Key="Diag.Export">진단 정보 내보내기</sys:String>
</ResourceDictionary>
