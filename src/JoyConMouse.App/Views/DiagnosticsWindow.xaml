<Window x:Class="JoyConMouse.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource Diag.Title}" Width="620" SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" FontSize="13" Background="#FFF9FAFB">
    <StackPanel Margin="16">
        <TextBlock Text="{StaticResource Diag.Latency}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Latency}" Margin="0,2,0,12" TextWrapping="Wrap" />
        <TextBlock Text="{StaticResource Diag.Tick}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Tick}" Margin="0,2,0,12" TextWrapping="Wrap" />
        <TextBlock Text="{StaticResource Diag.Timer}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Timer}" Margin="0,2,0,12" />
        <TextBlock Text="{StaticResource Diag.Failures}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Failures}" Margin="0,2,0,12" />
        <TextBlock Text="{StaticResource Diag.Note}" Foreground="#FF6B7280" TextWrapping="Wrap" FontSize="12" />
        <Button x:Name="ExportButton" Content="{StaticResource Diag.Export}" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="12,4" Click="OnExportClick" />
    </StackPanel>
</Window>
