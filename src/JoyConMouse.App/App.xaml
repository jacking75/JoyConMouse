<Application x:Class="JoyConMouse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JoyConMouse.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Strings.ko.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:NullToVisibilityConverter x:Key="NullToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
